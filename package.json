{
  "name": "unvisible",
  "version": "0.1.0",
  "description": "Unvisible - a screen-aware overlay that keeps its own window out of screenshots and screen recordings.",
  "main": "src/main.js",
  "private": true,
  "scripts": {
    "vendor": "node scripts/vendor-shoelace.js",
    "postinstall": "node scripts/vendor-shoelace.js",
    "start": "electron .",
    "dev": "electron . --dev",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "lint": "eslint src"
  },
  "author": "leason",
  "license": "MIT",
  "devDependencies": {
    "electron": "^29.1.4",
    "electron-builder": "^24.13.3"
  },
  "dependencies": {
    "@floating-ui/core": "^1.8.0",
    "@shoelace-style/shoelace": "^2.20.1",
    "ali-oss": "^6.20.0",
    "electron-store": "^8.2.0",
    "marked": "^12.0.2",
    "openai": "^4.100.0",
    "proxy-agent": "^5.0.0"
  },
  "build": {
    "appId": "com.leason.unvisible",
    "productName": "unvisible",
    "directories": {
      "output": "release"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.developer-tools"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "linux": {
      "target": [
        "AppImage"
      ]
    }
  }
}
